@startuml
' Code PlantUML: copy this entire file, including @startuml and @enduml.
hide circle
hide methods
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 85
skinparam class {
  BackgroundColor White
  HeaderBackgroundColor #EEEEEE
  BorderColor Black
  FontColor Black
  FontStyle bold
  AttributeFontStyle plain
}
top to bottom direction

title ERD logic - 4. Giáo án và buổi tập

entity "exercises" as exercises {
  {field} **PK**  id : BIGINT
  {field}       calories_burned : INTEGER
  {field}       default_duration_seconds : INTEGER
  {field}       default_reps : INTEGER
  {field}       default_sets : INTEGER
  {field}       endurance_score : INTEGER
  {field}       flexibility_score : INTEGER
  {field}       is_active : BOOLEAN
  {field}       is_assessment : BOOLEAN
  {field}       maintenance_score : INTEGER
  {field}       muscle_gain_score : INTEGER
  {field}       rest_seconds : INTEGER
  {field}       stamina_cost : INTEGER
  {field}       uses_weight : BOOLEAN
  {field}       weight_loss_score : INTEGER
  {field}       contraindicated_injuries : VARCHAR(255)
  {field}       description : VARCHAR(255)
  {field}       image_url : VARCHAR(255)
  {field}       name : VARCHAR(255)
  {field}       secondary_muscle_groups : VARCHAR(255)
  {field}       video_url : VARCHAR(255)
  {field}       assessment_metric_type : ENUM
  {field}       difficulty : ENUM
  {field}       muscle_group : ENUM
}

entity "plan_muscle_group_weight" as plan_muscle_group_weight {
  {field} **PK**  id : BIGINT
  {field} **FK**  workout_plan_id : BIGINT
  {field}       multiplier : FLOAT(53)
  {field}       muscle_group : ENUM
}

entity "session_exercise_logs" as session_exercise_logs {
  {field} **PK**  id : BIGINT
  {field} **FK**  exercise_id : BIGINT
  {field} **FK**  session_id : BIGINT
  {field}       completion_percent : INTEGER
  {field}       duration_seconds : INTEGER
  {field}       is_completed : BOOLEAN
  {field}       reps_completed : INTEGER
  {field}       sets_completed : INTEGER
  {field}       weight_used_kg : FLOAT(53)
  {field}       logged_at : TIMESTAMP(6)
  {field}       notes : VARCHAR(255)
}

entity "users" as users {
  {field} **PK**  id : BIGINT
  {field} **FK**  role_id : BIGINT
  {field}       email_verified : BOOLEAN
  {field}       password_reset_attempts : INTEGER
  {field}       status : BOOLEAN
  {field}       created_at : TIMESTAMP(6)
  {field}       password_reset_blocked_until : TIMESTAMP(6)
  {field}       email : VARCHAR(255)  [UK]
  {field}       full_name : VARCHAR(255)
  {field}       password : VARCHAR(255)
  {field}       phone : VARCHAR(255)
  {field}       verification_token : VARCHAR(255)
}

entity "weekly_reviews" as weekly_reviews {
  {field} **PK**  id : BIGINT
  {field} **FK**  user_id : BIGINT
  {field} **FK**  workout_plan_id : BIGINT
  {field}       rating : INTEGER
  {field}       week_number : INTEGER
  {field}       created_at : TIMESTAMP(6)
  {field}       comment : VARCHAR(255)
}

entity "workout_plan_days" as workout_plan_days {
  {field} **PK**  id : BIGINT
  {field} **FK**  workout_plan_id : BIGINT
  {field}       day_of_week : INTEGER
  {field}       day_name : VARCHAR(255)
}

entity "workout_plan_exercises" as workout_plan_exercises {
  {field} **PK**  id : BIGINT
  {field} **FK**  exercise_id : BIGINT
  {field} **REF**  last_low_adjustment_log_id : BIGINT
  {field} **FK**  plan_day_id : BIGINT
  {field}       base_weight_kg : FLOAT(53)
  {field}       current_recommended_weight_kg : FLOAT(53)
  {field}       current_weight_kg : FLOAT(53)
  {field}       duration_seconds : INTEGER
  {field}       is_assessment : BOOLEAN
  {field}       order_index : INTEGER
  {field}       recommended_weight_kg : FLOAT(53)
  {field}       reps : INTEGER
  {field}       rest_seconds : INTEGER
  {field}       sets : INTEGER
  {field}       weight_updated_week : INTEGER
  {field}       notes : VARCHAR(255)
}

entity "workout_plans" as workout_plans {
  {field} **PK**  id : BIGINT
  {field} **REF**  original_plan_id : BIGINT
  {field} **FK**  user_id : BIGINT
  {field}       current_mana : INTEGER
  {field}       current_week : INTEGER
  {field}       difficulty_adjustment : INTEGER
  {field}       duration_weeks : INTEGER
  {field}       estimated_weeks : INTEGER
  {field}       exercises_adjustment : INTEGER
  {field}       fitness_score : INTEGER
  {field}       is_active : BOOLEAN
  {field}       is_ai_generated : BOOLEAN
  {field}       is_completed : BOOLEAN
  {field}       is_fitness_improvement : BOOLEAN
  {field}       is_template : BOOLEAN
  {field}       last_mana_regen_date : DATE
  {field}       last_training_date : DATE
  {field}       max_mana : INTEGER
  {field}       reps_adjustment : INTEGER
  {field}       required_max_session_mana_cost : INTEGER
  {field}       sessions_per_week : INTEGER
  {field}       sets_adjustment : INTEGER
  {field}       starting_bmi : FLOAT(53)
  {field}       starting_weight : FLOAT(53)
  {field}       target_achieved : BOOLEAN
  {field}       target_baseline_value : FLOAT(53)
  {field}       target_current_value : FLOAT(53)
  {field}       target_goal_value : FLOAT(53)
  {field}       target_metric_type : TINYINT
  {field}       week_start_date : DATE
  {field}       created_at : TIMESTAMP(6)
  {field}       confirmed_schedule_dows : VARCHAR(255)
  {field}       description : VARCHAR(255)
  {field}       plan_name : VARCHAR(255)
  {field}       weight_adjustment_note : VARCHAR(255)
  {field}       body_type : ENUM
  {field}       fitness_level : ENUM
  {field}       goal : ENUM
  {field}       target_level : ENUM
}

entity "workout_sessions" as workout_sessions {
  {field} **PK**  id : BIGINT
  {field} **FK**  plan_day_id : BIGINT
  {field} **FK**  user_id : BIGINT
  {field} **FK**  workout_plan_id : BIGINT
  {field}       checkout_body_fat : FLOAT(53)
  {field}       checkout_weight : FLOAT(53)
  {field}       completion_rate : INTEGER
  {field}       duration_minutes : INTEGER
  {field}       is_custom : BOOLEAN
  {field}       is_last_session_of_week : BOOLEAN
  {field}       scheduled_time : TIME(6)
  {field}       session_date : DATE
  {field}       total_calories_burned : INTEGER
  {field}       week_number : INTEGER
  {field}       check_in_time : TIMESTAMP(6)
  {field}       check_out_time : TIMESTAMP(6)
  {field}       custom_session_name : VARCHAR(255)
  {field}       notes : VARCHAR(255)
  {field}       status : ENUM
}
workout_plans |o--o{ plan_muscle_group_weight
exercises |o--o{ session_exercise_logs
workout_sessions |o--o{ session_exercise_logs
users |o--o{ weekly_reviews
workout_plans |o--o{ weekly_reviews
workout_plans |o--o{ workout_plan_days
exercises |o--o{ workout_plan_exercises
workout_plan_days |o--o{ workout_plan_exercises
users |o--o{ workout_plans
workout_plan_days |o--o{ workout_sessions
users |o--o{ workout_sessions
workout_plans |o--o{ workout_sessions
workout_plans |o..o{ workout_plans
session_exercise_logs |o..o{ workout_plan_exercises
legend bottom
  PK: khóa chính. FK: khóa ngoại hiện có. UK: khóa duy nhất.
  REF / nét đứt: liên kết logic bổ sung, chưa phải FK của ứng dụng.
endlegend
@enduml
